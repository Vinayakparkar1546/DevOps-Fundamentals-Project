<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Offline Action Game</title>

<style>
body{
    margin:0;
    background:#111;
    overflow:hidden;
    font-family:Arial;
}

canvas{
    display:block;
    margin:auto;
    background:#222;
    border:4px solid white;
}

#info{
    position:absolute;
    left:20px;
    top:20px;
    color:white;
    font-size:22px;
}
</style>

</head>

<body>

<div id="info">
Health : <span id="health">100</span><br>
Score : <span id="score">0</span>
</div>

<canvas id="game" width="900" height="600"></canvas>

<script>

const canvas=document.getElementById("game");
const ctx=canvas.getContext("2d");

let keys={};

let player={
x:450,
y:300,
size:25,
speed:5,
health:100
};

let bullets=[];
let enemies=[];
let score=0;

document.addEventListener("keydown",e=>keys[e.key]=true);
document.addEventListener("keyup",e=>keys[e.key]=false);

function shoot(){

bullets.push({
x:player.x,
y:player.y,
dx:8,
dy:0,
size:6
});

}

setInterval(()=>{
enemies.push({
x:900,
y:Math.random()*560+20,
size:20,
speed:2+Math.random()*2
});
},900);

function update(){

if(keys["ArrowUp"]||keys["w"])player.y-=player.speed;
if(keys["ArrowDown"]||keys["s"])player.y+=player.speed;
if(keys["ArrowLeft"]||keys["a"])player.x-=player.speed;
if(keys["ArrowRight"]||keys["d"])player.x+=player.speed;

player.x=Math.max(20,Math.min(canvas.width-20,player.x));
player.y=Math.max(20,Math.min(canvas.height-20,player.y));

if(keys[" "]){
keys[" "]=false;
shoot();
}

bullets.forEach(b=>b.x+=b.dx);

enemies.forEach(e=>{

e.x-=e.speed;

if(e.x<player.x+20 &&
e.x>player.x-20 &&
e.y<player.y+20 &&
e.y>player.y-20){

player.health-=10;
e.dead=true;

}

});

bullets.forEach(b=>{

enemies.forEach(e=>{

let dx=b.x-e.x;
let dy=b.y-e.y;

if(Math.sqrt(dx*dx+dy*dy)<20){

b.dead=true;
e.dead=true;
score+=10;

}

});

});

bullets=bullets.filter(b=>!b.dead&&b.x<900);
enemies=enemies.filter(e=>!e.dead&&e.x>-20);

document.getElementById("health").innerText=player.health;
document.getElementById("score").innerText=score;

}

function draw(){

ctx.clearRect(0,0,900,600);

ctx.fillStyle="cyan";
ctx.beginPath();
ctx.arc(player.x,player.y,player.size,0,Math.PI*2);
ctx.fill();

ctx.fillStyle="yellow";

bullets.forEach(b=>{

ctx.beginPath();
ctx.arc(b.x,b.y,b.size,0,Math.PI*2);
ctx.fill();

});

ctx.fillStyle="red";

enemies.forEach(e=>{

ctx.beginPath();
ctx.arc(e.x,e.y,e.size,0,Math.PI*2);
ctx.fill();

});

if(player.health<=0){

ctx.fillStyle="white";
ctx.font="60px Arial";
ctx.fillText("GAME OVER",250,300);

ctx.font="30px Arial";
ctx.fillText("Final Score : "+score,330,360);

return;

}

requestAnimationFrame(gameLoop);

}

function gameLoop(){

update();
draw();

}

gameLoop();

</script>

</body>
</html>
